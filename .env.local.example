# Copy this file to .env.local and fill in the values from your Supabase
# project settings (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Google OAuth client used so each user can connect their own Google account
# to sync their own tracker sheets (see README.md "Google Sheet sync" section
# for how to create one).
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret

# Anthropic API key used by "Update from notes" to compare pasted notes
# against a project's README/tasks. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
